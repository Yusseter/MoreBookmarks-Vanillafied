	}
}
# Yusseter 1

#######################################################################
#######################################################################
#######################################################################

# Each font should specify what it is used for.
# Name fonts after intented usage, not after source file names.

font = {
	name = "Debug"

	fontstyle = {
		style = regular
		fontfiles = "OpenSans-SemiBold"
	}
}

## Font used in-game
font = {
	name = "StandardGameFont"

	fontstyle = {
		style = regular
		fontfiles = "NotoSerif-Regular" # Yusseter
		#fontfiles = "Gitan-Regular"
	}

	fontstyle = {
		style = bold
		fontfiles = "NotoSerif-Bold" # Yusseter
		#fontfiles = "Gitan-Bold"
	}

	fontstyle = {
		style = italic
		fontfiles = "NotoSerif-Italic" # Yusseter
		#fontfiles = "Gitan-Italic"
	}

	fontstyle = {
		style = bold|italic
		fontfiles = "NotoSerif-Bold-Italic" # Yusseter
		#fontfiles = "Gitan-Bold-Italic"
	}

	underlineformats = {
		default = {
			thickness = 1
			offset = 0.12
		}
	}
}

# Title font
font = {
	name = "TitleFont"

	fontstyle = {
		style = regular
		fontfiles = "Fondamento-Regular"
	}
}

# For map names
font = {
	name = "MapFont"

	fontstyle = {
		style = regular
		fontfiles = "Paradox_King_Script"
	}
}
