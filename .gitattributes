# Default
* text=auto

# Text files
*.txt text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.csv text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.patch text eol=lf
*.code-workspace text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# CK3 text files
# Defer checkout line endings to Git configuration instead of the general LF rules.
BookmarksGit/**/*.txt text !eol
BookmarksGit/**/*.yml text !eol
BookmarksGit/**/*.gui text !eol
BookmarksGit/**/*.gfx text !eol
BookmarksGit/**/*.font text !eol
BookmarksGit/**/*.asset text !eol
BookmarksGit/**/*.mod text !eol
BookmarksGit/**/*.info text !eol
BookmarksGit/**/*.map text !eol
BookmarksGit/**/*.conf text !eol
BookmarksGit/**/*.settings text !eol
BookmarksGit/**/*.editordata text !eol
BookmarksGit/**/*.particle2 text !eol
BookmarksGit/**/*.terrain text !eol
BookmarksGit/**/*.heightmap text !eol

# Binary files
*.png binary
*.dds binary
*.tga binary
*.jpg binary
*.jpeg binary
*.pdn binary
*.ttf binary
*.otf binary
*.anim binary
*.mesh binary
*.dat binary
*.psd binary
*.pdf binary
*.exe binary

# Use automatic text detection without forcing checkout line endings in relocated upstream material
upstream-extras/** text=auto !eol
